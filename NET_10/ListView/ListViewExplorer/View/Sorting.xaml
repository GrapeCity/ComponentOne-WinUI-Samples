<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ListViewExplorer.Sorting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ListViewExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:C1.WinUI.Core"
    xmlns:listView="using:C1.WinUI.ListView"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <core:C1Button x:Name="btnSort" Margin="10 0 0 10" HorizontalAlignment="Left" Click="btnSort_Click" />
        <listView:C1ListView x:Name="listView" Grid.Row="1" ItemHeight="30" DisplayMemberPath="Name" Margin="10 0 10 10"/>
    </Grid>
</UserControl>
