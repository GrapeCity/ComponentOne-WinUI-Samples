<Application
    x:Class="MenuExplorer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c1="using:C1.WinUI.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <DataTemplate x:Key="ProjectIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-cog.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="WebProjectIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-link.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="TeamProjectIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-account.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="FileNewIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-plus.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="FileIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-check.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="OpenIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/folder-open.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="CloseIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/file-remove.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="SaveIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/save.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="SaveAllIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/save-all.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="PageSetupIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/printer-edit.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="PrintIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/printer.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="ExitIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/exit-run.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="UndoIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/undo.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="RedoIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/redo.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="CutIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/cut.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="CopyIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/copy.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="PasteIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/paste.svg"/>
            </DataTemplate>
            <DataTemplate x:Key="DeleteIconTemplate">
                <c1:C1SvgIcon Source="ms-appx:///Resources/Menu/trash-can.svg"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
