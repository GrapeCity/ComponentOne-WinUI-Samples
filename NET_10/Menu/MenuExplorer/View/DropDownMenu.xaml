<UserControl x:Class="MenuExplorer.DropDownMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:input="using:C1.WinUI.Input"
             xmlns:menu="using:C1.WinUI.Menu" 
             xmlns:c1="using:C1.WinUI.Menu"
             xmlns:res="using:MenuExplorer.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <input:C1DropDownButton DropDownWidth="176" HorizontalAlignment="Center" VerticalAlignment="Center" Header="Click here to see menu">
            <c1:C1MenuList>
                <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_File}">
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_New}" IconTemplate="{StaticResource FileNewIconTemplate}">
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Project}" IconTemplate="{StaticResource ProjectIconTemplate}"/>
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_WebSite}" IconTemplate="{StaticResource WebProjectIconTemplate}"/>
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_TeamProject}" IconTemplate="{StaticResource TeamProjectIconTemplate}"/>
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_File}" HotKey="Ctrl+N" IconTemplate="{StaticResource FileIconTemplate}"/>
                    </c1:C1MenuItem>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Open}" IconTemplate="{StaticResource OpenIconTemplate}">
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Project}" HotKey="Ctrl+O" IconTemplate="{StaticResource ProjectIconTemplate}"/>
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_WebSite}" IconTemplate="{StaticResource WebProjectIconTemplate}"/>
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_File}" IconTemplate="{StaticResource FileIconTemplate}"/>
                    </c1:C1MenuItem>
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Close}" IconTemplate="{StaticResource CloseIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_CloseSolution}" IconTemplate="{StaticResource CloseIconTemplate}"/>
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Save}" HotKey="Ctrl+S" IconTemplate="{StaticResource SaveIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_SaveAll}" IconTemplate="{StaticResource SaveAllIconTemplate}"/>
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_PageSetup}" IconTemplate="{StaticResource PageSetupIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Print}" HotKey="Ctrl+P" IconTemplate="{StaticResource PrintIconTemplate}"/>
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Exit}" HotKey="Alt+F4" IconTemplate="{StaticResource ExitIconTemplate}"/>
                </c1:C1MenuItem>
                <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Edit}">
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Undo}"  IconTemplate="{StaticResource UndoIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Redo}" IconTemplate="{StaticResource RedoIconTemplate}"/>
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Cut}" IconTemplate="{StaticResource CutIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Copy}" IconTemplate="{StaticResource CopyIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Paste}" IconTemplate="{StaticResource PasteIconTemplate}"/>
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.SubMenuItem_Delete}" IconTemplate="{StaticResource DeleteIconTemplate}"/>
                </c1:C1MenuItem>
                <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Window}">
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Document1}" IsCheckable="True" IsChecked="True" />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Document2}" IsCheckable="True" IsChecked="True" />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Document3}" IsCheckable="True" />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Document4}" IsCheckable="True" />
                    <c1:C1MenuSeparator />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Exclusive1}" GroupName="Exclusives" IsCheckable="True" IsChecked="True" />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Exclusive2}" GroupName="Exclusives" IsCheckable="True" IsChecked="True" />
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Exclusive3}" GroupName="Exclusives" IsCheckable="True" />
                </c1:C1MenuItem>
                <c1:C1MenuItem Header="{x:Bind res:AppResources.MenuItem_Deep}">
                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Deep1}">
                        <c1:C1MenuItem Header="{x:Bind res:AppResources.Deep2}">
                            <c1:C1MenuItem Header="{x:Bind res:AppResources.Deep3}">
                                <c1:C1MenuItem Header="{x:Bind res:AppResources.Deep4}">
                                    <c1:C1MenuItem Header="{x:Bind res:AppResources.Deep5}">
                                    </c1:C1MenuItem>
                                </c1:C1MenuItem>
                            </c1:C1MenuItem>
                        </c1:C1MenuItem>
                    </c1:C1MenuItem>
                </c1:C1MenuItem>
            </c1:C1MenuList>
        </input:C1DropDownButton>
    </Grid>
</UserControl>
