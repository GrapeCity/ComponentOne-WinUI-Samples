<UserControl
    x:Class="FlexGridExplorer.ConditionalFormatting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c1="using:C1.WinUI.Grid"
    xmlns:cf="using:C1.WinUI.Grid.ConditionalFormatting"
    xmlns:rules="using:C1.WinUI.RulesManager"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <c1:FlexGrid x:Name="grid" AutoGenerateColumns="False">
        <c1:FlexGrid.Columns>
            <c1:GridColumn Binding="FirstName"/>
            <c1:GridColumn Binding="LastName"/>
            <c1:GridColumn Binding="OrderTotal" Format="C2"/>
            <c1:GridColumn Binding="OrderCount" Format="N1"/>
            <c1:GridColumn Binding="CountryId" Header="Country"/>
            <c1:GridDateTimeColumn Binding="LastOrderDate" Mode="Date"/>
            <c1:GridDateTimeColumn Binding="LastOrderDate" Header="Last Order Time" Mode="Time"/>
        </c1:FlexGrid.Columns>
        <i:Interaction.Behaviors>
            <cf:ConditionalFormattingBehavior>
                <rules:C1RulesEngine>
                    <rules:RulesEngineSegmentsRule x:Name="segmentsRule">
                        <rules:RulesEngineSegment Value="50">
                            <rules:RulesEngineStyle Background="#FFFDE7E9"/>
                        </rules:RulesEngineSegment>
                        <rules:RulesEngineSegment>
                            <rules:RulesEngineStyle Background="#FFDFF6DD"/>
                        </rules:RulesEngineSegment>
                    </rules:RulesEngineSegmentsRule>
                </rules:C1RulesEngine>
            </cf:ConditionalFormattingBehavior>
        </i:Interaction.Behaviors>
    </c1:FlexGrid>
</UserControl>
