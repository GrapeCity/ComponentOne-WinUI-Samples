                <Style TargetType="c1:Node">
                    <Setter Property="Shape" Value="RoundedRectangle" />
                    <Setter Property="Title" Value="{Binding Name}" />
                    <Setter Property="TitleImage" Value="{Binding Image}" />
                    <Setter Property="TitleDirection" Value="Vertical" />
                </Style>
            </c1:FlexDiagram.Resources>-->
        </c1:FlexDiagram>
    </Grid>
</UserControl>
