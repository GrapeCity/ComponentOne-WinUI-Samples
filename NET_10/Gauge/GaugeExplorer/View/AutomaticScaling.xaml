<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GaugeExplorer.AutomaticScaling"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GaugeExplorer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:C1.WinUI.Core"
    xmlns:input="using:C1.WinUI.Input"
    xmlns:gauge="using:C1.WinUI.Gauge"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <gauge:C1RadialGauge x:Name="Gauge" AutoScale="True" MaxHeight="200"
                          Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" StartAngle="{Binding StartAngle}" SweepAngle="{Binding SweepAngle}" 
                          IsEnabled="True" TextVisibility="{Binding ShowText}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsReversed="{Binding IsReversed}"/>
        <core:C1WrapPanel Grid.Row="1">
            <TextBlock x:Name="lblStartAngle" Text="Start Angle " VerticalAlignment="Center" Margin="5"/>
            <input:C1NumericBox x:Name="StartAngleStepper" Value="{Binding StartAngle, Mode=TwoWay}" Maximum="360" Minimum="-360" Increment="45" VerticalAlignment="Center" ValueChanged="NumericBox_ValueChanged"/>
            <TextBlock x:Name="lblSweepAngle" Text="Sweep Angle " VerticalAlignment="Center"  Margin="5"/>
            <input:C1NumericBox x:Name="SweepAngleStepper" Value="{Binding SweepAngle, Mode=TwoWay}" Minimum="45" Maximum="360" Increment="45" HorizontalAlignment="Stretch" VerticalAlignment="Center" ValueChanged="NumericBox_ValueChanged"/>
            <StackPanel Orientation="Horizontal" Grid.Column="2"  Margin="5">
                <core:C1CheckBox x:Name="chkReversed" IsChecked="{Binding IsReversed, ElementName=Gauge, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblReversed" Text="Reversed " VerticalAlignment="Center" Margin="5"/>
            </StackPanel>
        </core:C1WrapPanel>
    </Grid>
</UserControl>
